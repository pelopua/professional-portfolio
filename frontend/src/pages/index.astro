---
import '../styles/global.css';
import { Image } from 'astro:assets';
import profilePhoto from '../assets/fermin-bermejo.jpg';
import { portfolio } from '../data/portfolio';

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8080';
const base = import.meta.env.BASE_URL;
const cvUrl = `${base}cv/CV_Fermin_Bermejo_Gonzalez.pdf`.replace(/\/+/g, '/');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Portfolio profesional de Fermín Bermejo González, Analista Funcional y Técnico Senior con experiencia en Java y certificación PSPO I." />
    <meta name="theme-color" content="#070a10" />
    <title>{portfolio.name} · Portfolio profesional</title>
  </head>
  <body>
    <header class="topbar">
      <div class="container nav">
        <a class="brand" href="#inicio" aria-label="Ir al inicio">FB<span>.</span></a>
        <nav aria-label="Navegación principal">
          <a href="#proyectos">Proyectos</a>
          <a href="#experiencia">Experiencia</a>
          <a href="#stack">Stack</a>
          <a href="#certificaciones">Certificaciones</a>
          <a href="#contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main>
      <section id="inicio" class="hero container">
        <div class="hero-copy">
          <p class="eyebrow">{portfolio.location} · Producto + Tecnología</p>
          <h1>{portfolio.name}</h1>
          <p class="headline">{portfolio.headline}</p>
          <p class="intro">{portfolio.intro}</p>
          <div class="actions">
            <a class="btn btn-primary" href="#contacto">Hablemos</a>
            <a class="btn btn-secondary" href={cvUrl} target="_blank" rel="noreferrer">Ver CV</a>
            <a class="btn btn-secondary" href={portfolio.linkedinUrl} target="_blank" rel="noreferrer" aria-label="Ver perfil de LinkedIn de Fermín Bermejo González">LinkedIn ↗</a>
          </div>
        </div>
        <aside class="identity-card" aria-label="Resumen profesional">
          <div class="profile-photo-frame">
            <Image
              src={profilePhoto}
              alt="Retrato profesional de Fermín Bermejo González"
              width={480}
              quality={85}
              loading="eager"
            />
          </div>
          <div>
            <p class="identity-role">Analista Funcional y Técnico Senior</p>
            <p class="muted">Java · Spring · Oracle · Product Thinking</p>
          </div>
          <div class="status"><span></span> Portfolio vivo · 2026</div>
        </aside>
      </section>

      <section class="section story-section">
        <div class="container story-layout">
          <div>
            <p class="eyebrow">Mi historia</p>
            <h2>De sistemas y soporte a ingeniería y producto.</h2>
          </div>
          <div class="story-list">
            {portfolio.journey.map((item, index) => (
              <article class="story-item">
                <span>0{index + 1}</span>
                <div><h3>{item.phase}</h3><p class="muted">{item.text}</p></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <p class="eyebrow">Propuesta de valor</p>
          <h2>Conecto negocio, arquitectura y entrega.</h2>
          <div class="grid value-grid">
            {portfolio.value.map((item, index) => (
              <article class="card value-card">
                <span>0{index + 1}</span>
                <p>{item}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="proyectos" class="section">
        <div class="container">
          <p class="eyebrow">Caso de estudio · Proyecto personal</p>
          <div class="project-heading">
            <div>
              <h2>{portfolio.featuredProject.name}</h2>
              <p class="project-summary">{portfolio.featuredProject.summary}</p>
            </div>
            <div class="project-role">
              <span class="eyebrow">Mi papel</span>
              <p>{portfolio.featuredProject.role}</p>
            </div>
          </div>
          <div class="project-details">
            <article>
              <h3>Reto</h3>
              <p>{portfolio.featuredProject.challenge}</p>
            </article>
            {portfolio.featuredProject.decisions.map((decision) => (
              <article>
                <h3>{decision.title}</h3>
                <p>{decision.detail}</p>
              </article>
            ))}
          </div>
          <div class="project-evidence">
            <div>
              <h3>Qué demuestra</h3>
              <ul>{portfolio.featuredProject.evidence.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div>
              <h3>Tecnologías</h3>
              <div class="pills">{portfolio.featuredProject.stack.map((item) => <span class="pill">{item}</span>)}</div>
            </div>
          </div>
          <p class="project-status"><strong>Estado:</strong> {portfolio.featuredProject.status}</p>
          <a class="case-study-link" href={`${base}caso-portfolio/`}>Leer el caso de estudio completo <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section id="experiencia" class="section">
        <div class="container">
          <p class="eyebrow">Trayectoria</p>
          <h2>Experiencia profesional</h2>
          <div class="timeline">
            {portfolio.experience.map((job) => (
              <article class="timeline-item">
                <div class="timeline-meta"><strong>{job.period}</strong></div>
                <div class="timeline-content">
                  <p class="eyebrow">{job.company}</p>
                  <h3>{job.role}</h3>
                  <p class="muted">{job.context}</p>
                  <ul>{job.highlights.map((item) => <li>{item}</li>)}</ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="stack" class="section">
        <div class="container">
          <p class="eyebrow">Stack técnico</p>
          <h2>Tecnología con contexto de negocio.</h2>
          <div class="grid stack-grid">
            {portfolio.technologies.map((group) => (
              <article class="card">
                <h3>{group.category}</h3>
                <div class="pills">{group.items.map((item) => <span class="pill">{item}</span>)}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="certificaciones" class="section">
        <div class="container">
          <p class="eyebrow">Aprendizaje continuo</p>
          <h2>Certificaciones y formación</h2>
          <div class="grid certification-grid">
            {portfolio.certifications.map((cert) => (
              <article class="card cert-card">
                <span class:list={["cert-status", cert.status === 'Obtenida' && 'done']}>{cert.status}</span>
                <p class="cert-code">{cert.code}</p>
                <h3>{cert.name}</h3>
                <p class="muted">{cert.issuer}{cert.date ? ` · ${cert.date}` : ''}</p>
              </article>
            ))}
          </div>
          <div class="education-layout">
            <div>
              <h3>Formación reglada</h3>
              {portfolio.education.map((item) => (
                <div class="education-row">
                  <strong>{item.title}</strong>
                  <span class="muted">{item.center} · {item.period}</span>
                </div>
              ))}
            </div>
            <div>
              <h3>Formación complementaria</h3>
              <div class="pills">{portfolio.complementaryTraining.map((item) => <span class="pill">{item}</span>)}</div>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container objective">
          <div>
            <p class="eyebrow">Siguiente etapa</p>
            <h2>De Analista Senior a Product Owner.</h2>
          </div>
          <p>{portfolio.objective}</p>
        </div>
      </section>

      <section id="contacto" class="section contact-section">
        <div class="container contact-layout">
          <div>
            <p class="eyebrow">Contacto</p>
            <h2>¿Tienes un reto de producto o tecnología?</h2>
            <p class="muted">Responderé a su consulta a la mayor brevedad posible, gracias.</p>
          </div>
          <form id="contact-form" class="contact-form" data-api-base-url={apiBaseUrl}>
            <label>
              Nombre
              <input name="name" autocomplete="name" maxlength="120" required />
            </label>
            <label>
              Email
              <input name="email" type="email" autocomplete="email" maxlength="200" required />
            </label>
            <label>
              Mensaje
              <textarea name="message" rows="6" minlength="10" maxlength="3000" required></textarea>
            </label>
            <label class="honeypot" aria-hidden="true">
              Website
              <input name="website" tabindex="-1" autocomplete="off" />
            </label>
            <button class="btn btn-primary" type="submit">Enviar mensaje</button>
            <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <span>© 2026 {portfolio.name}</span>
        <span class="muted">Construido con Java, Spring Boot y Astro.</span>
      </div>
    </footer>

    <script>
      const form = document.querySelector('#contact-form');
      const status = document.querySelector('#form-status');

      if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          status.textContent = 'Enviando…';

          const submit = form.querySelector('button[type="submit"]');
          if (submit instanceof HTMLButtonElement) submit.disabled = true;

          const data = Object.fromEntries(new FormData(form).entries());
          const apiBaseUrl = form.dataset.apiBaseUrl || 'http://localhost:8080';

          try {
            const response = await fetch(`${apiBaseUrl}/api/v1/contact`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data)
            });

            if (!response.ok) throw new Error(`HTTP ${response.status}`);

            form.reset();
            status.textContent = 'Mensaje enviado correctamente. Gracias por contactar.';
          } catch (error) {
            console.error(error);
            status.textContent = 'No se ha podido enviar. Comprueba que la API esté disponible.';
          } finally {
            if (submit instanceof HTMLButtonElement) submit.disabled = false;
          }
        });
      }
    </script>

    <style>
      .topbar { position: sticky; top:0; z-index:20; backdrop-filter: blur(18px); background:rgba(7,10,16,.78); border-bottom:1px solid var(--line); }
      .nav { min-height:68px; display:flex; align-items:center; justify-content:space-between; gap:1rem; }
      .brand { font-weight:950; font-size:1.25rem; text-decoration:none; letter-spacing:-.05em; }
      .brand span { color:var(--accent); }
      nav { display:flex; gap:1.1rem; flex-wrap:wrap; justify-content:flex-end; }
      nav a { color:var(--muted); text-decoration:none; font-size:.9rem; }
      nav a:hover { color:var(--text); }
      .hero { min-height:700px; padding:8rem 0 6rem; display:grid; grid-template-columns:minmax(0,1.45fr) minmax(280px,.55fr); gap:4rem; align-items:center; }
      .hero h1 { font-size:clamp(2.75rem,6.25vw,5.25rem); line-height:.94; letter-spacing:-.055em; margin:.6rem 0 1.4rem; max-width:12ch; }
      .headline { font-size:clamp(1.15rem,2.4vw,1.65rem); max-width:760px; margin:0 0 1rem; }
      .intro { color:var(--muted); max-width:720px; font-size:1.05rem; }
      .actions { display:flex; gap:.7rem; flex-wrap:wrap; margin-top:2rem; }
      .identity-card { border:1px solid var(--line); background:linear-gradient(145deg,rgba(143,179,255,.08),rgba(110,231,199,.04)); border-radius:1.6rem; padding:1.4rem; min-height:340px; display:flex; flex-direction:column; justify-content:space-between; }
      .profile-photo-frame { width:120px; aspect-ratio:1; overflow:hidden; border-radius:50%; border:1px solid rgba(143,179,255,.35); background:var(--surface-2); box-shadow:0 0 0 6px rgba(143,179,255,.06); }
      .profile-photo-frame img { display:block; width:100%; height:100%; object-fit:cover; }
      .identity-role { font-weight:800; font-size:1.2rem; margin-bottom:.2rem; }
      .status { color:var(--muted); font-size:.9rem; display:flex; align-items:center; gap:.5rem; }
      .status span { width:9px; height:9px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 5px rgba(110,231,199,.09); }
      .story-layout { display:grid; grid-template-columns:.8fr 1.2fr; gap:5rem; }
      .story-list { border-top:1px solid var(--line); }
      .story-item { display:grid; grid-template-columns:55px 1fr; gap:1rem; padding:1.35rem 0; border-bottom:1px solid var(--line); }
      .story-item > span { color:var(--accent); font-weight:800; font-size:.82rem; }
      .story-item h3 { margin:0 0 .25rem; }
      .story-item p { margin:0; }
      .value-grid { grid-template-columns:repeat(4,1fr); }
      .value-card span { color:var(--muted); font-size:.78rem; }
      .value-card p { font-size:1.05rem; font-weight:700; margin:2rem 0 0; }
      .project-heading { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(230px,.6fr); gap:3rem; align-items:end; }
      .project-heading h2 { margin-bottom:.8rem; }
      .project-summary { max-width:720px; color:var(--muted); font-size:1.1rem; }
      .project-role { border-left:2px solid var(--accent); padding-left:1rem; }
      .project-role .eyebrow { margin:0; }
      .project-role p { margin:.4rem 0 0; font-weight:700; }
      .project-details { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 3rem; margin-top:2rem; }
      .project-details article { border-top:1px solid var(--line); padding:1.2rem 0; }
      .project-details h3, .project-evidence h3 { margin:0 0 .4rem; font-size:1rem; }
      .project-details p { margin:0; color:var(--muted); }
      .project-evidence { display:grid; grid-template-columns:1fr 1fr; gap:3rem; margin-top:1rem; }
      .project-evidence ul { margin:.5rem 0 0; padding-left:1.2rem; color:var(--muted); }
      .project-status { border-top:1px solid var(--line); padding-top:1rem; margin-top:2rem; color:var(--muted); font-size:.92rem; }
      .project-status strong { color:var(--text); }
      .timeline { display:grid; }
      .timeline-item { display:grid; grid-template-columns:220px minmax(0,1fr); gap:2rem; padding:2.1rem 0; border-top:1px solid var(--line); }
      .timeline-content h3 { margin:.2rem 0; font-size:1.55rem; }
      .timeline-content ul { padding-left:1.2rem; color:#c8d2df; }
      .stack-grid { grid-template-columns:repeat(3,1fr); }
      .stack-grid h3 { margin-top:0; }
      .pills { display:flex; flex-wrap:wrap; gap:.55rem; }
      .certification-grid { grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); }
      .cert-card { position:relative; min-height:220px; }
      .cert-status { position:absolute; top:1rem; right:1rem; border:1px solid var(--line); border-radius:999px; padding:.3rem .55rem; color:var(--muted); font-size:.76rem; }
      .cert-status.done { color:var(--accent); border-color:rgba(110,231,199,.25); }
      .cert-code { font-size:2rem; font-weight:900; letter-spacing:-.04em; margin:.5rem 0 2.6rem; }
      .cert-card h3 { margin-bottom:.4rem; }
      .education-layout { display:grid; grid-template-columns:1fr 1fr; gap:3rem; margin-top:3rem; }
      .education-row { padding:1rem 0; border-top:1px solid var(--line); display:grid; gap:.2rem; }
      .objective { display:grid; grid-template-columns:1.3fr .7fr; gap:4rem; align-items:end; }
      .objective h2 { margin-bottom:0; }
      .objective > p { font-size:1.1rem; color:var(--muted); }
      .contact-section { background:rgba(255,255,255,.018); }
      .contact-layout { display:grid; grid-template-columns:.85fr 1.15fr; gap:5rem; }
      .contact-form { display:grid; gap:1rem; }
      .contact-form label { display:grid; gap:.45rem; font-size:.88rem; font-weight:700; color:#d8e1ed; }
      input, textarea { width:100%; border:1px solid var(--line); border-radius:.75rem; background:#090e16; color:var(--text); padding:.8rem .9rem; font:inherit; font-size:16px; }
      input:focus, textarea:focus { outline:2px solid var(--accent-2); outline-offset:2px; }
      button:disabled { opacity:.55; cursor:wait; }
      .honeypot { position:absolute !important; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }
      .form-status { min-height:1.6rem; margin:0; color:var(--muted); }
      footer { border-top:1px solid var(--line); padding:2rem 0; }
      .footer-inner { display:flex; justify-content:space-between; gap:1rem; flex-wrap:wrap; font-size:.9rem; }
      @media (max-width:900px) {
        .hero { grid-template-columns:1fr; min-height:0; padding-top:6rem; }
        .identity-card { min-height:260px; }
        .value-grid, .stack-grid { grid-template-columns:repeat(2,1fr); }
        .timeline-item { grid-template-columns:150px minmax(0,1fr); }
        .contact-layout, .objective, .story-layout, .project-heading, .project-details, .project-evidence { grid-template-columns:1fr; gap:2rem; }
      }
      @media (max-width:640px) {
        nav { display:none; }
        .hero { padding:4.5rem 0 3.5rem; gap:2rem; }
        .value-grid, .stack-grid, .certification-grid, .education-layout { grid-template-columns:1fr; }
        .timeline-item { grid-template-columns:1fr; gap:.5rem; }
      }
    </style>
  </body>
</html>
